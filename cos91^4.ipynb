import mpmath
mpmath.mp.dps = 100

val = mpmath.cos(mpmath.pi / 180)
terms = []
for _ in range(28):
    integer_part = mpmath.floor(val)
    terms.append(int(integer_part))
    fractional_part = val - integer_part
    if fractional_part == 0:
        break
    val = 1 / fractional_part

print(terms)
